{
  "circuit": {
    "family": "product_state",
    "n_qubits": [
      6
    ],
    "n_generators": "n"
  },
  "dataset": {
    "n_samples": 256,
    "type": "product_bernoulli"
  },
  "estimation": {
    "batch_size": 32,
    "num_a_samples": 64,
    "num_z_samples": 128
  },
  "experiment": {
    "description": "Small exact learned-distribution smoke test",
    "name": "training_smoke",
    "output_dir": "C:\\Users\\cuqui\\merlin-quantum-case-study\\results\\v4_tcdp\\sibling_retraining\\training_smoke",
    "seed": 11
  },
  "init": {
    "scheme": "small_angle",
    "small_angle": {
      "std": [
        0.15
      ]
    }
  },
  "kernel": {
    "bandwidth": [
      4.0
    ],
    "type": "gaussian"
  },
  "training": {
    "checkpoint_every": 1,
    "diagnostics": {
      "anti_concentration": {
        "alphas": [
          0.5,
          1.0,
          2.0
        ],
        "beta_min": 0.25,
        "primary_alpha": 1.0,
        "second_moment_threshold": 1.0
      },
      "distribution_mode": "exact",
      "enabled": true,
      "exact_probability_max_n": 8,
      "max_order": 3,
      "max_subsets_per_order": 20,
      "sample_count": 2048,
      "sample_from_exact_probability_max_n": 8
    },
    "exact_loss_max_n": 8,
    "loss_mode": "exact_small_n",
    "lr": 0.05,
    "num_steps": 4,
    "optimizer": "sgd"
  }
}