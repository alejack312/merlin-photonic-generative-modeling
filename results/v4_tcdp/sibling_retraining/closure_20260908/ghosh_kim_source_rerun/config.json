{
  "experiment": {
    "name": "ghosh_kim_small_n_v4_retrain",
    "description": "Isolated faithful rerun of the pinned sibling Ghosh-Kim small-n cells",
    "seed": 21,
    "output_dir": "results/v4_tcdp/sibling_retraining/closure_20260908/ghosh_kim_source_rerun",
    "log_level": "INFO"
  },
  "circuit": {
    "family": "lattice",
    "allow_legacy_families": false,
    "n_qubits": [
      9
    ],
    "n_generators": "n",
    "lattice": {
      "dimension": 2,
      "range": 1
    },
    "erdos_renyi": {
      "p_edge": [
        2.0
      ]
    },
    "bounded_degree": {
      "max_weight": 3,
      "max_degree": 4
    },
    "dense": {
      "expected_weight": 0.5
    },
    "community": {
      "n_blocks": 4,
      "p_intra": 0.8,
      "p_inter": 0.05
    },
    "symmetric": {
      "parity": "even"
    }
  },
  "kernel": {
    "type": "gaussian",
    "bandwidth": [
      1.0,
      3.0,
      9.0
    ],
    "multi_scale_gaussian": {
      "sigmas": [
        0.5,
        1.0,
        2.0
      ],
      "weights": null
    }
  },
  "init": {
    "scheme": "uniform",
    "uniform": {
      "low": -3.14159265,
      "high": 3.14159265
    },
    "small_angle": {
      "std": [
        0.01,
        0.1,
        0.3
      ]
    },
    "data_dependent": {
      "dataset": "ising",
      "method": "parity",
      "scale": 0.1,
      "fallback_std": 0.1
    }
  },
  "dataset": {
    "type": "binary_mixture",
    "n_samples": 512,
    "ising": {
      "beta": 1.0,
      "coupling_std": 1.0,
      "topology": "grid_2d"
    },
    "binary_mixture": {
      "n_modes": 4,
      "noise": 0.1,
      "threshold": 0.0
    }
  },
  "estimation": {
    "num_a_samples": 128,
    "num_z_samples": 256,
    "num_seeds": 100,
    "use_jax": true,
    "batch_size": 64
  },
  "training": {
    "optimizer": "adam",
    "lr": 0.03,
    "num_steps": 20,
    "checkpoint_every": 5,
    "loss_mode": "exact_small_n",
    "exact_loss_max_n": 12,
    "diagnostics": {
      "enabled": true,
      "distribution_mode": "exact",
      "exact_probability_max_n": 12,
      "sample_from_exact_probability_max_n": 12,
      "sample_count": 4096,
      "max_order": 9,
      "max_subsets_per_order": 128,
      "anti_concentration": {
        "alphas": [
          0.5,
          1.0,
          2.0
        ],
        "primary_alpha": 1.0,
        "beta_min": 0.25,
        "second_moment_threshold": 1.0
      }
    }
  },
  "qiskit": {
    "backend": "statevector",
    "n_shots": [
      1000,
      10000,
      100000
    ],
    "max_n": 20,
    "noise": {
      "enabled": false,
      "model": "depolarizing",
      "error_rate": [
        0.001,
        0.005,
        0.01
      ]
    }
  },
  "forge": {
    "max_n": 12,
    "timeout_sec": 60,
    "mode": "template_search",
    "query_template": "plateau_inducing_bounded",
    "thresholds": {
      "max_weight": 3,
      "overlap_threshold": 2
    },
    "export_instances": true,
    "plateau_agreement": {
      "label_source": "results/scaling_ac_smoke/results.jsonl",
      "label_kind": "concentration",
      "ac_field": "ac_passes_primary_threshold"
    }
  }
}